# Pochva-MCP — переменные окружения. Реальный .env: chmod 600, НЕ в git.
# Порт слушаем только внутри docker-сетей (opora-network + vl-network), наружу НЕ публикуем.
PORT=8788

# ── ДВА РУБЕЖА AUTH — разные токены, компрометация одного не даёт второго ──────
# ВХОД: Bearer владельца. Им телефон/curl/скрипты аутентифицируются на /mcp.
OPORA_MCP_INBOUND_TOKEN=CHANGE_ME_long_random_1
# ВЫХОД: сервисный токен к opora-core API. Другой токен, свой скоуп, отзыв независим.
OPORA_MCP_TOKEN=CHANGE_ME_long_random_2

# Адрес ядра внутри opora-network (по имени контейнера). Наружу ядро не смотрит.
OPORA_CORE_URL=http://opora-core:3000

# ── ТРЕТИЙ РУБЕЖ: OAuth 2.0 для коннектора Claude (диалог claude.ai не умеет headers) ──
# Все OPORA_MCP_OAUTH_* генерируются скриптом scripts/gen-oauth-secrets.mjs — руками не вписывать.
OPORA_MCP_OAUTH_ISSUER=https://d.pavellevdin.ru
OPORA_MCP_OAUTH_RESOURCE=https://d.pavellevdin.ru/mcp
OPORA_MCP_OWNER_SUB=ЗАМЕНИТЬ-сгенерировать-scripts/gen-oauth-secrets.mjs
OPORA_MCP_OAUTH_CLIENT_ID=CHANGE_ME_client_id
OPORA_MCP_OAUTH_CLIENT_SECRET=CHANGE_ME_client_secret
OPORA_MCP_OAUTH_SIGNING_KEY=CHANGE_ME_hex64
# scrypt-хеш кодовой фразы: scrypt$N$r$p$saltB64url$hashB64url (не сама фраза!).
OPORA_MCP_OAUTH_PASSWORD_HASH=CHANGE_ME_scrypt_hash
# Bump + recreate = отзыв всех выданных access/refresh токенов.
OPORA_MCP_OAUTH_TOKEN_GEN=1
OPORA_MCP_OAUTH_ACCESS_TTL=3600
OPORA_MCP_OAUTH_REFRESH_TTL=7776000
